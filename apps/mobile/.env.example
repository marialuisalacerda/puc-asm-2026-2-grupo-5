# Copie para .env (ignorado pelo git) e ajuste conforme o ambiente.
# Variáveis EXPO_PUBLIC_* são embutidas no bundle: nunca coloque segredos aqui.

# URL base da API (docs/api/openapi.yaml).
#   Web / simulador iOS: http://localhost:8080
#   Emulador Android:    http://10.0.2.2:8080
#   Celular físico:      http://<IP-da-sua-máquina>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080

# true  = dados simulados no aparelho (MockPlantaoPetApi), não precisa de backend
# false = chama a API real (HttpPlantaoPetApi)
EXPO_PUBLIC_USE_MOCKS=true

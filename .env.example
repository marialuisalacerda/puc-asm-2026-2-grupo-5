# Copie para .env (não versionado) e ajuste se necessário.
# Valores fictícios, apenas para ambiente local.

# PostgreSQL (nomes alinhados a docs/database/README.md)
DB_NAME=plantao_pet
DB_USERNAME=plantao_pet
DB_PASSWORD=plantao_pet_local
DB_PORT=5432

# Banco próprio do notification-worker
NOTIFICATION_DB_NAME=notifications
NOTIFICATION_DB_USERNAME=notifications
NOTIFICATION_DB_PASSWORD=notifications_local

# RabbitMQ
RABBITMQ_USER=plantao_pet
RABBITMQ_PASSWORD=plantao_pet_local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Aplicação
API_PORT=8080
WORKER_PORT=8082

# Observabilidade
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
JAEGER_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
